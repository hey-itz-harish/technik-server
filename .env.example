PORT=8080
GIN_MODE=release
APP_ENV=production

DATABASE_URL="postgresql://user:password@hostname:5432/technik_db?sslmode=require&schema=public"
JWT_SECRET="generate_a_cryptographically_secure_random_string_min_64_chars"
CSRF_SECRET="generate_another_cryptographically_secure_random_string_min_64_chars"

COOKIE_DOMAIN=".technikolympiad.com"
COOKIE_SECURE=true
FRONTEND_URL="https://www.technikolympiad.com"
ALLOWED_ORIGINS="https://www.technikolympiad.com,https://technikolympiad.com"

# Razorpay Payment Gateway Configuration
RAZORPAY_KEY_ID="rzp_live_your_live_key_id"
RAZORPAY_KEY_SECRET="your_live_key_secret"

# Initial Super Admin Auto-Seed (Optional, only seeds if account does not exist)
ADMIN_INITIAL_EMAIL="hari@technikolympiad.com"
ADMIN_INITIAL_PASSWORD="your_strong_admin_initial_password"

# Resend Mail Configuration (Primary)
RESEND_API_KEY="re_your_resend_api_key"
RESEND_FROM_EMAIL="Technik Olympiad <noreply@technikolympiad.com>"

# Zoho Mail SMTP Configuration (Fallback)
ZOHO_SMTP_HOST="smtp.zoho.in"
ZOHO_SMTP_PORT="587"
ZOHO_SMTP_USER="support@technikolympiad.com"
ZOHO_SMTP_PASS="your_zoho_password"
ZOHO_FROM_EMAIL="support@technikolympiad.com"

